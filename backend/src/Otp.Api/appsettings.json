{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Otp": {
    "SecretKey": "",
    "ValiditySeconds": 30,
    "CodeLength": 6,
    "MaxFailedAttempts": 3,
    "LockoutSeconds": 60,
    "CleanupIntervalSeconds": 60
  },
  "RateLimiting": {
    "PermitLimit": 30,
    "WindowSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": []
  }
}

<Project>

  <!-- Applies to every project under backend/ (src and tests). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>

    <!-- Run on the newest installed .NET runtime when the .NET 8 runtime is not installed.
         Without this, a machine that only has .NET 9 or 10 builds fine but cannot start the
         API or the test host ("You must install or update .NET to run this application"). -->
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>8.0</AnalysisLevel>
    <Deterministic>true</Deterministic>

    <!-- The build fails on any compiler warning and on any .editorconfig style or naming rule set to "warning". -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Vulnerability-audit notices depend on the network; they are reported but never break an offline build. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

</Project>

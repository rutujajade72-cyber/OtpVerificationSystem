# Copy to .env.local to override. Both values are optional.

# Base URL of the API. Leave empty during development: Vite proxies /api to the backend.
# Set it for a production build served from a different origin, for example:
# VITE_API_BASE_URL=https://otp.example.com
VITE_API_BASE_URL=

# Digits per one-time password. Must match Otp:CodeLength in the API (default 6, allowed 4 to 9).
# VITE_OTP_CODE_LENGTH=6
